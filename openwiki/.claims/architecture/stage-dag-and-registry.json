  "claims": [
    {
      "id": "claim_550e5a9aea834be3b9e5d99f169f9530",
      "statement": "A stage is registered by decorating a RunContext-taking function with @stage(StageMeta(...)), which inserts a StageDef into a module-global registry keyed by name and returns the function unchanged.",
      "evidence": [
        {
          "resource": "repo://pipeline/core/_stage_base.py#L112-L112",
          "version": "repo-lines-v1:sha256:c1d5d5058f6ed58b545a6637550720693acf2565b5d18f50cab51444b3e2e368:"
