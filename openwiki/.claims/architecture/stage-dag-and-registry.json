          "version": "repo-lines-v1:sha256:ebf7bf53dbe764740e0da78e95468fb10f5f28421895c055fbe83a34e0a5984b:"
        }
      ]
    },
    {
      "id": "claim_b5b8ac17e671410598dcc3e8ddc073b9",
      "statement": "Registering two stages under the same name raises RuntimeError naming the function that already holds it, turning a collision between stage modules into an import-time failure rather than a silent shadowing.",
      "evidence": [
        {
          "resource": "repo://pipeline/core/registry.py#L23-L29",
          "version": "repo-lines-v1:sha256:912cd394ef17e0f1dace2abbf53b8f0b509c627a45a0d7d80b0fdbd86560a76c:"
        }
      ]
    },
