    {
      "id": "claim_4026fa67fbee4d15b63efe82ed4002d0",
      "statement": "Every Cypher statement issued by the direct writer goes through run_with_retry, which retries Neo4j TransientError up to twenty times with exponential backoff plus random jitter capped at ten seconds, absorbing the deadlocks caused by concurrent MERGE on shared nodes.",
      "evidence": [
        {
          "resource": "repo://pipeline/core/neo4j_driver.py#L16-L48",
