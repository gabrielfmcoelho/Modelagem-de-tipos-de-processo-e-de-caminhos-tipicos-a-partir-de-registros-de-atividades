          "version": "repo-lines-v1:sha256:c662d431ac6bfa1d334ffe756bc90a44d611d0ac10100a0ac204f610e1d7d048:"
        }
      ]
    },
    {
      "id": "claim_1af8c707043046858e8643129f915415",
      "statement": "_io_for closes writer, reader and driver in its finally block with each close wrapped in its own try/except, so a failure releasing one resource cannot prevent the others from being released.",
