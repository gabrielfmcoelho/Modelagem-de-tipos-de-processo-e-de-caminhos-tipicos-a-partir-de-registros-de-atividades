    {
      "id": "claim_748b5c7080804ad2a2f70506bb0df70b",
      "statement": "DirectNeo4jWriter compiles node and edge writes into UNWIND statements whose primitive is MERGE on the declared key fields rather than CREATE, which is what makes re-running a stage against a populated database update instead of duplicate.",
      "evidence": [
        {
          "resource": "repo://pipeline/writers/neo4j_writer.py#L34-L66",
          "version": "repo-lines-v1:sha256:eb98774b6c0c746dbdf584115ec3763e2f56b1278b78bb5060d71a56aee48b65:"
        }
