          "version": "repo-lines-v1:sha256:c7fe332029c6c344b189302f93729edb1dc52a1c7b814acc10a2e823fd9f6cef:"
        }
      ]
    },
    {
      "id": "claim_8036dd1fbb7e46ac9e7707812af87696",
      "statement": "pick_mode applies a fixed precedence: an explicit mode flag wins, otherwise a configured read directory selects json-replay, otherwise a configured emit directory selects json-emit, otherwise the default is neo4j.",
      "evidence": [
        {
          "resource": "repo://pipeline/core/runner.py#L85-L93",
          "version": "repo-lines-v1:sha256:ad28fb06e384f532c6b3de3a0ef06c7e38d3d1d4acd1bdacb5846fac286fe0b9:"
        }
      ]
    },
    {
      "id": "claim_04fdd0937e1441b9962ce54502f2a081",
      "statement": "The run-level mode is only a preference: _resolved_mode_for falls back to a stage's first declared mode when the stage does not support the chosen one, so a single run can execute different stages in different modes.",
      "evidence": [
        {
          "resource": "repo://pipeline/core/runner.py#L195-L202",
          "version": "repo-lines-v1:sha256:b92cd456da3a22ae9883825cb7e959c08839e44de6557c5452b40c7c72faa9d6:"
        }
      ]
    },
    {
