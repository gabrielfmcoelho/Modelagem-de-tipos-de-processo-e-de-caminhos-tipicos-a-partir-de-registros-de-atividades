  "claims": [
    {
      "id": "claim_ddcdbaa6c07141d591c31ac3cfc14f9a",
      "statement": "Execution mode is a closed set of four values (neo4j, json-emit, json-replay, fs) that selects which concrete GraphWriter and GraphReader a stage receives, so graph-touching stages never construct a database connection themselves.",
      "evidence": [
        {
          "resource": "repo://pipeline/core/_stage_base.py#L11-L11",
          "version": "repo-lines-v1:sha256:365da3a2ebdcadefddb7a28aca11b23f95f5ad515b34831afb3f8436a98f0e01:"
        },
        {
