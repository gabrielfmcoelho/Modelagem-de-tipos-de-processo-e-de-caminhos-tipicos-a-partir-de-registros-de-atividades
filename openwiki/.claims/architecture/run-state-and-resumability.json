    {
      "id": "claim_b6621dfc62dd457cb3fc6f126f501d28",
      "statement": "On failure the runner checkpoints failed_at, the error string and the formatted traceback, writes the ledger entry, and then re-raises, so the plan aborts without running later stages while the next invocation still sees a non-complete record and retries that stage.",
      "evidence": [
        {
          "resource": "repo://pipeline/core/runner.py#L301-L311",
          "version": "repo-lines-v1:sha256:f42a67b0a4c3f08d73c72aa4416a45657fb1667813a2a2f9a605985d35d15449:"
        }
      ]
    },
    {
      "id": "claim_098683383c724ee7a319b90af91b5bbc",
      "statement": "The stage ledger copies the stage's phase, research question and determinism declaration directly from its registry metadata, so an auditor reads a stage's determinism claim from the same source the code registered rather than from a separate description.",
