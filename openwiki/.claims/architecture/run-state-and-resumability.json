    {
      "id": "claim_ed442163768042a496b1fb06ced595b3",
      "statement": "args_compatible compares only a fixed tuple of corpus-defining keys (from_date, to_date, limit, from, to, orgao) rather than the full flag dictionaries, so changing any other flag does not invalidate an existing checkpoint and the operator must pass force-stage explicitly.",
      "evidence": [
        {
          "resource": "repo://pipeline/core/runner.py#L257-L257",
          "version": "repo-lines-v1:sha256:5aadfb0f780f67af67207a75da6dc6f1b3926d1d69c7b06820983e8e8e4755e1:"
