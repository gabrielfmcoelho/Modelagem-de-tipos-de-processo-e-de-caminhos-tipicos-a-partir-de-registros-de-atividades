    {
      "id": "claim_6a82f292b9f0451a9f7d577b393d7f43",
      "statement": "A stage reports its metrics by writing a cache key named after itself with hyphens replaced by underscores and a _summary suffix; the runner reads that key out of the shared cache and persists it with the checkpoint.",
