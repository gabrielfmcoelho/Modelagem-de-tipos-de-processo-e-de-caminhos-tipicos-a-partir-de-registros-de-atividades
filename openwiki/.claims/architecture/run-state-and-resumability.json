    {
      "id": "claim_486f2d0f017844f19ec7ca6637cb8221",
      "statement": "A single shared cache dictionary is created once per run and passed to every stage's RunContext, so ctx.cached lets consecutive stages compute an expensive value such as a loaded model or corpus at most once per run.",
