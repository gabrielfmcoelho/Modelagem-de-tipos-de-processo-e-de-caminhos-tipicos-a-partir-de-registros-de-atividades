          "version": "repo-lines-v1:sha256:728744ddda9444d15dd1c162b8209b963565b1aaa1f26cec97ad0d7c58584c81:"
        },
        {
          "resource": "repo://pipeline/core/state.py#L30-L44",
          "version": "repo-lines-v1:sha256:5ef7e3688038f121e6a5a8fbdb9ef32ffa8dfe3989bb916ffdbb2821727db40a:"
        }
      ]
    },
    {
      "id": "claim_4f49b1b2283247fdb000a98ecbc56d38",
      "statement": "StageRecord.is_complete requires completed_at to be set and failed_at to be unset, so a record encodes three distinguishable states: never run, running or failed, and done.",
      "evidence": [
        {
          "resource": "repo://pipeline/apps/status.py#L98-L113",
          "version": "repo-lines-v1:sha256:62315067e32a0cc00c21a414437d7b0843ebfc808e3eb310c0707f5f84765b08:"
        },
        {
          "resource": "repo://pipeline/core/state.py#L14-L27",
          "version": "repo-lines-v1:sha256:39caa1cb9b25bda4a0c7d9f65e8555cdd78b9875c0b97785a6ab9b3a2cf5bca6:"
        }
      ]
    },
    {
      "id": "claim_a68e36fdeaff49e48753bb5845c24511",
      "statement": "Checkpoint writes are atomic: write_stage serialises to a .tmp sibling and then replaces it onto the target path, so an interruption mid-write cannot leave a truncated checkpoint to be misread on the next run.",
      "evidence": [
        {
          "resource": "repo://pipeline/core/state.py#L54-L59",
          "version": "repo-lines-v1:sha256:8deeee9875a99593e676a6c4aad2d73e33cb60bbdd3baa4c604330f865f2d318:"
        }
      ]
    },
    {
      "id": "claim_2539cfb5d98c48a3b8c0cb87053e1a6d",
      "statement": "Checkpoint reads fail safe toward re-running: read_stage returns None on invalid JSON and all_records skips records that fail to decode or carry unexpected fields, so a corrupted checkpoint causes the stage to re-run rather than crashing the pipeline.",
      "evidence": [
        {
          "resource": "repo://pipeline/core/state.py#L44-L52",
          "version": "repo-lines-v1:sha256:4ea2c221554a5e45a66faba30d64cdc74df24ceae475f802d0d240163daf4f48:"
        },
        {
          "resource": "repo://pipeline/core/state.py#L77-L88",
          "version": "repo-lines-v1:sha256:edffbb49bea3167fa38fb968c79f0f07341d4910926f2e99215329eaf3932063:"
        }
      ]
    },
    {
      "id": "claim_256b92b34c074e56b45d1dfd8497141e",
      "statement": "try_lock implements a PID-based single-writer guard with stale-lock recovery: it probes the recorded PID with signal 0, refuses the lock when that process is alive, and takes over the lock when the PID is dead or the lock file cannot be parsed.",
      "evidence": [
        {
          "resource": "repo://pipeline/core/state.py#L107-L120",
          "version": "repo-lines-v1:sha256:89798873eb096a301b0ca55499c695a8d306506661abbe8e8c1102bf4c1dce0b:"
        }
      ]
    },
    {
      "id": "claim_0f7a271fbd604bad88a98077bcb4c1ea",
      "statement": "The run lock is acquired before any stage executes and released in the finally block that also appends the run history, including on the early return taken by a dry resolution.",
      "evidence": [
        {
          "resource": "repo://pipeline/core/runner.py#L211-L229",
          "version": "repo-lines-v1:sha256:ee7662273d69bcbb17a80627554e129abc99a09b29557ee882a5c4c717ae4598:"
        },
        {
          "resource": "repo://pipeline/core/runner.py#L316-L328",
          "version": "repo-lines-v1:sha256:fa4d2343f83486a324aaf0a9a0392e0b041b8e1c9b6ef1c02b07bbd7ac63fd5b:"
        }
      ]
    },
    {
      "id": "claim_5203910340804816980bb3503f06cbe2",
      "statement": "The run lock compares process ids on the local machine only, so it does not coordinate concurrent runs across separate hosts or containers sharing a mounted state directory.",
      "evidence": [
        {
          "resource": "repo://pipeline/core/state.py#L107-L120",
          "version": "repo-lines-v1:sha256:89798873eb096a301b0ca55499c695a8d306506661abbe8e8c1102bf4c1dce0b:"
        }
      ]
    },
    {
      "id": "claim_2fd866f81f5247219270c1cf4983a9f0",
      "statement": "A stage is skipped only when its record exists and is complete, the stage declares can_skip_when_done, neither force nor force_stage names it, and the recorded arguments are compatible with the current flags.",
