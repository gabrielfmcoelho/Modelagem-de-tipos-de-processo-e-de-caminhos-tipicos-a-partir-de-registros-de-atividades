  "claims": [
    {
      "id": "claim_e6d711fbead247b3b619b0a54f00dac9",
      "statement": "The pipeline keeps control state and audit evidence in two separate places: checkpoints under the state directory decide whether a stage may be skipped, while ledger entries under artifacts/runs describe what a stage did and are never consulted for control decisions.",
      "evidence": [
        {
          "resource": "repo://pipeline/core/runner.py#L248-L299",
          "version": "repo-lines-v1:sha256:59f46ad71ebcf8123ffa4ea9c8113b096ed05b03db05a00bd1b6ad411257e9f2:"
        },
        {
