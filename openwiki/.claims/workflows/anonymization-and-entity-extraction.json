          "version": "repo-lines-v1:sha256:0fe3d4499b726de8760a809c87a02095246ea522ffc0750ee464bbd76ee5baf4:"
        }
      ]
    },
    {
      "id": "claim_7fb2a031ef2b49248a3b18208bb880cb",
      "statement": "With the verify flag the stage re-runs its regular expression detectors against its own anonymized output, counting and logging residual hits at error level as a self-check on the guarantee it exists to provide.",
      "evidence": [
        {
          "resource": "repo://pipeline/stages/anonymize.py#L117-L119",
