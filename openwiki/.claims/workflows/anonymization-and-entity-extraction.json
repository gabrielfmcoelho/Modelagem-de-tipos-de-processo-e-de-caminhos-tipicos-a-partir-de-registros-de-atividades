  "claims": [
    {
      "id": "claim_4ba94dc86de94dad8e7ffce8ca9c5214",
      "statement": "Anonymization combines two independent detection sources — checksum-validated regular expression matching and filtered NER model output — whose results are concatenated before replacement.",
      "evidence": [
        {
          "resource": "repo://pipeline/model/anonymize.py#L117-L145",
          "version": "repo-lines-v1:sha256:4f274e463bccf5f2030c69772e1e57dc5fe9844af4794fa271f8ef8e66613711:"
        },
        {
          "resource": "repo://pipeline/stages/anonymize.py#L96-L97",
          "version": "repo-lines-v1:sha256:902528a3ec17f1c2899cb0dd0536957a2d66df342663cb26397581329a767e60:"
        }
      ]
    },
    {
      "id": "claim_9ac4caae48b344568e5d64c909d5c0cd",
      "statement": "CPF and CNPJ candidates are redacted only when their check digits validate, and both validators additionally reject sequences of a single repeated digit, so a bare digit run that is not a valid identifier is left in the text rather than redacted.",
      "evidence": [
        {
          "resource": "repo://pipeline/model/anonymize.py#L128-L139",
          "version": "repo-lines-v1:sha256:c1f31a8eebc8727a3f5beed2db7b270a631bb59572e46f4c18d0b8ff0d2d4920:"
        },
        {
          "resource": "repo://pipeline/model/anonymize.py#L74-L100",
          "version": "repo-lines-v1:sha256:29f8a963a406eb542b513f249c91e66471d1a2b942f978d3e3008adecd7d75b6:"
        },
        {
          "resource": "repo://pipeline/tests/test_anonymize.py#L39-L41",
          "version": "repo-lines-v1:sha256:251af62ab6278e4f7d0f74868d2f8e5b728aaa2fc399257f59d3dc8dca964d06:"
        }
      ]
    },
    {
      "id": "claim_d96b1ee513714751a308bff9978da1a3",
      "statement": "Staff registration numbers are detected only in the presence of the literal keyword context and when the captured span carries at least five digits, since the number alone is indistinguishable from other identifiers.",
      "evidence": [
        {
          "resource": "repo://pipeline/model/anonymize.py#L12-L16",
          "version": "repo-lines-v1:sha256:ed84685b81009555246f5c4420d52d65cc0d91c53e1dec75b179e83ac654f1fb:"
        },
        {
          "resource": "repo://pipeline/model/anonymize.py#L141-L145",
          "version": "repo-lines-v1:sha256:e2a740dfcfe10985acf775e59a368db62bce3d9541d21d71dc1cf72dd0b696dc:"
        }
      ]
    },
    {
      "id": "claim_a27feca4180242a6a14e0dcb0c71e455",
      "statement": "Model-proposed spans pass three gates before becoming redactable: the label must map to a known placeholder class or be dropped, the span must reach a minimum length, and the span must actually occur in the source text when compared case-folded — a guard against a model proposing an entity that is not present.",
      "evidence": [
        {
          "resource": "repo://pipeline/model/anonymize.py#L149-L173",
          "version": "repo-lines-v1:sha256:0fb09e922b18c5dde80925fae57fc1b474d5fab148af1f712bd0e5518577a7a3:"
        }
      ]
    },
    {
      "id": "claim_3181bb6c710d402a9816cccb99aaa107",
      "statement": "The label mapping deliberately folds a long tail of Brazilian document types — identity cards, driving licences, social security and professional registrations, bank accounts and vehicle identifiers — into a single generic DOCUMENTO placeholder class.",
      "evidence": [
        {
          "resource": "repo://pipeline/model/anonymize.py#L19-L57",
          "version": "repo-lines-v1:sha256:5812c7abc368927accf4c6ce35a3d00d8203e8ce4ec3e48fd34d78d6c782c3ae:"
        }
      ]
    },
    {
      "id": "claim_24d5ad224fe7475082f7a3f2944a9db8",
      "statement": "A placeholder is the entity class name plus the first eight hexadecimal characters of a SHA-256 over the label and canonical key, so the same entity yields the same placeholder in every document while the placeholder alone does not recover the original value.",
      "evidence": [
        {
          "resource": "repo://pipeline/model/anonymize.py#L111-L115",
          "version": "repo-lines-v1:sha256:a73702be5976987f9ca2b38ed97c01492efa09c3087608833a8a04e0dd8bdd9f:"
        }
      ]
    },
    {
      "id": "claim_ff40b2fc036a4677ad70f872ecbd36f4",
      "statement": "Canonicalisation differs by class: digit-bearing labels are reduced to digits plus the letter X and uppercased, while text labels are NFKD-normalised, stripped of combining marks, whitespace-collapsed and case-folded, so formatting, accent and casing variants converge on one pseudonym.",
      "evidence": [
        {
          "resource": "repo://pipeline/model/anonymize.py#L103-L108",
          "version": "repo-lines-v1:sha256:dc1c0a6f95bce9c23b003600cbfb58d1561ac33b9ad5228948cb3596e4da3563:"
        }
      ]
    },
    {
      "id": "claim_67ab1c9bad4847d7a4ad208324a9ae2c",
      "statement": "Replacement processes entities longest-first and rejects any match overlapping an already-claimed interval, which prevents a shorter entity such as a surname from corrupting a longer one such as the full name containing it.",
      "evidence": [
        {
          "resource": "repo://pipeline/model/anonymize.py#L175-L201",
          "version": "repo-lines-v1:sha256:a1bb3ae9f0e144eacd6d997d03d83b032961edbfe078f5740dc48bd08f216db4:"
        }
      ]
    },
    {
      "id": "claim_4afcd901c7ab46f1b0c9b26a3cbd3629",
      "statement": "Each label class receives boundary guards suited to it — no adjacent digit for digit classes, an email-specific character class for addresses, and word boundaries otherwise — with case-insensitive matching.",
      "evidence": [
        {
          "resource": "repo://pipeline/model/anonymize.py#L184-L193",
          "version": "repo-lines-v1:sha256:5e7bb25a36a1c31fa6901d4912ba44338f69be450e29a9e7f649861a7b977701:"
        }
      ]
    },
    {
      "id": "claim_d4411eab2e8342ae9d5200996a78691e",
      "statement": "The anonymized text is assembled in a single pass from the sorted non-overlapping claimed intervals rather than by mutating the original string.",
      "evidence": [
        {
          "resource": "repo://pipeline/model/anonymize.py#L200-L209",
          "version": "repo-lines-v1:sha256:263f191b7c547d8def449ac59dd3912a6321f33d64716718c1d9c766ee1c9e25:"
        }
      ]
    },
    {
      "id": "claim_06f8a959556a467496f26f895ef883a3",
      "statement": "The anonymize stage hard-depends on parse but only soft-depends on ner-extract, so it runs without NER results and records in each document's metadata whether a payload was available.",
      "evidence": [
        {
          "resource": "repo://pipeline/stages/anonymize.py#L101-L110",
          "version": "repo-lines-v1:sha256:dc161d9e3fc02f44c4c69673b6294e20131a8a7f92f8676e06c14afca35221cc:"
        },
        {
          "resource": "repo://pipeline/stages/anonymize.py#L32-L43",
          "version": "repo-lines-v1:sha256:8d706ee9733995418f3bce41a4f4c4c24ba89d0fa1c3c865f462a94e74beaa17:"
        }
      ]
    },
    {
      "id": "claim_da22f1ccf63044668ccfc56152ced62a",
      "statement": "The stage writes an anonymized text file and a metadata file beside each parsed document using the variant filenames the parsed store defines, so downstream consumers select an experimental arm by requesting the raw or anon variant rather than by pointing at different directories.",
      "evidence": [
        {
          "resource": "repo://pipeline/core/parsed_store.py#L41-L55",
          "version": "repo-lines-v1:sha256:2334f69e743721623b5ee754c5dc647651978fe2ac2024142fac6c7009b8c413:"
        },
        {
          "resource": "repo://pipeline/core/parsed_store.py#L8-L13",
          "version": "repo-lines-v1:sha256:1064a64dfca3c1d41b0944528b1e02f2700d5284775cb10c2d75ef27bf823b37:"
        },
        {
          "resource": "repo://pipeline/stages/anonymize.py#L83-L84",
          "version": "repo-lines-v1:sha256:c05c16f2f7817d91f0437063bc4f5260d447628d88907885d0e6961ea45988e5:"
        }
      ]
    },
    {
      "id": "claim_b4cae288ff7741f1a4ee19cee6c3fd68",
      "statement": "Beyond the stage checkpoint the anonymize stage keeps a content-addressed per-document skip rule, reprocessing a document unless the stored metadata records both the same source text digest and the same NER payload digest, so new NER results regenerate exactly the affected documents.",
      "evidence": [
        {
          "resource": "repo://pipeline/stages/anonymize.py#L81-L94",
          "version": "repo-lines-v1:sha256:71b0d9b52f29a8e6791651a75ee559371d0c0a279ade30452db5787969157e1e:"
        }
      ]
    },
    {
      "id": "claim_f6879902748147069e0a562b47560696",
      "statement": "Anonymization degrades rather than aborting: an unreadable or malformed NER payload leaves that document regex-only with a warning, a missing NER directory puts every document on that path, and the stage counts how many documents were degraded.",
      "evidence": [
        {
          "resource": "repo://pipeline/stages/anonymize.py#L112-L116",
          "version": "repo-lines-v1:sha256:4321fdc84d2a30f06de027aa74059819e8834be7aad338228154e51ac722b27d:"
