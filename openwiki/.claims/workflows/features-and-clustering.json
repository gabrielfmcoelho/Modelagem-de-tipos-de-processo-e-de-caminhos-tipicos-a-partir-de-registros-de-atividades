  "claims": [
    {
      "id": "claim_2e2be51abbd541c191aedf0dd6936963",
      "statement": "A process feature vector is assembled from six independently weighted blocks — semantic document embeddings, first-document topic, unit unigram and bigram TF-IDF, activity-type histogram and keyword TF-IDF — each carrying its own multiplier defaulting to one, which is the structure the ablation stage manipulates rather than editing the feature builder.",
      "evidence": [
        {
          "resource": "repo://pipeline/model/processo_features.py#L264-L290",
          "version": "repo-lines-v1:sha256:b52f8f0f11df8aaabb4d148d3df4673b283860623a56716fa2f49b7c1c45bb09:"
        },
        {
          "resource": "repo://pipeline/model/processo_features.py#L53-L60",
          "version": "repo-lines-v1:sha256:af2b34ade2adf33334c909fad1914f78e22700ebd02d298a3c115d498bafa8d5:"
        },
        {
          "resource": "repo://pipeline/stages/ablation.py#L16-L18",
          "version": "repo-lines-v1:sha256:1879ac18ef087ba28490325fc1205f917af3ad61eec4e88198f6e36e6c3be92b:"
        }
      ]
    },
    {
      "id": "claim_5b82c13e037f49c799ccf75e3566f574",
      "statement": "Documents are not weighted equally inside the semantic block: the first document carries triple weight, documents up to rank three carry one and a half, and the remainder carry one, so the opening document dominates the semantic representation.",
      "evidence": [
        {
          "resource": "repo://pipeline/model/processo_features.py#L45-L51",
          "version": "repo-lines-v1:sha256:9ac561df49f46f4e73cbf7f4d115f7efd36dc72d8da5acd5d9d3769e09c60764:"
        },
        {
          "resource": "repo://pipeline/model/processo_features.py#L90-L96",
          "version": "repo-lines-v1:sha256:4cd341580ce8a5e6a49b74db52ee96e8fbab61351bdb2a0798c42c81b69df941:"
        }
      ]
    },
    {
      "id": "claim_8466dd93ff414cf8a730d8183f1d6e7e",
      "statement": "The activity-type vocabulary is built by sorting task groups and their tasks and appending a catch-all bucket, which keeps histogram dimensions stable across runs and prevents an unrecognised activity type from shifting every other dimension's index.",
      "evidence": [
        {
          "resource": "repo://pipeline/model/processo_features.py#L19-L31",
          "version": "repo-lines-v1:sha256:2cf50db356656aa39b1ef7c9ecf26c0cc07534ca182ea324c9b8d5e519fc3560:"
        }
      ]
    },
    {
      "id": "claim_fc29cb9233604700b701691811eaffd2",
      "statement": "Unit sequences are stripped of consecutive repeats before bigrams are formed, so a process that remains in one unit across many activities does not generate a run of self-transitions.",
      "evidence": [
        {
          "resource": "repo://pipeline/model/processo_features.py#L98-L110",
          "version": "repo-lines-v1:sha256:18d9727b1784225de94df58799ae836df861b21a66174acdb5e1e4a9cfbd079f:"
        }
      ]
    },
    {
      "id": "claim_366623e563154f1a9c3cac75488fe322",
      "statement": "Feature blocks are L2-normalised before combination so that no block dominates the vector through raw magnitude alone.",
      "evidence": [
        {
          "resource": "repo://pipeline/model/processo_features.py#L63-L74",
          "version": "repo-lines-v1:sha256:281ab043057f41ce5e326270a7bde9b595bd7b413cad99e262d4ce8975d6df2e:"
        }
      ]
    },
    {
      "id": "claim_abcd87f7b7484ec6965390dd26d5e157",
      "statement": "feature_hash digests the algorithm version, every weight, the per-document embedding hashes, the sorted set of visited units, the deduplicated chronological unit sequence and the sorted activity-type counts, so re-embedding a document or changing a weight invalidates the cached vector.",
      "evidence": [
        {
          "resource": "repo://pipeline/model/processo_features.py#L190-L245",
          "version": "repo-lines-v1:sha256:763e6bc19535dc2f922dc8824be457dbe39d6bd1f095902888a27612b9ddcbe2:"
        }
      ]
    },
    {
      "id": "claim_384942e9329145bcb209e3badd9df0d4",
      "statement": "The keyword block weight and the temporal cutoff enter the feature hash only when they differ from their defaults, a deliberate backwards-compatibility choice that kept previously computed hashes valid when those parameters were introduced.",
      "evidence": [
        {
          "resource": "repo://pipeline/model/processo_features.py#L215-L220",
          "version": "repo-lines-v1:sha256:5403c931e351d870a7c8192960a6c382f4d7b67438444eeab9d16fb42c7b946a:"
        }
