    {
      "id": "claim_6e72157916ba45b6ae0bff6ba358121e",
      "statement": "full_population_metrics makes density and partitional methods comparable by reassigning every noise point to the nearest cluster centroid by cosine similarity before recomputing, and reports how many points were reassigned; when there is no noise it short-circuits and reports zero.",
