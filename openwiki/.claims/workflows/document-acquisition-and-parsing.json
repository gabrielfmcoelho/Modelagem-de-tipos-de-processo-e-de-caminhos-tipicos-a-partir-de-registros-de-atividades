        }
      ]
    },
    {
      "id": "claim_a128ec0a5d9445c7a1a78b4abfc2503b",
      "statement": "A denied-access response moves to the next candidate unit while recording the one attempted, and the download function returns a status of ok, cancelled or failed alongside the payload.",
