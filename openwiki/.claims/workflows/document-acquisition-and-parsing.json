    {
      "id": "claim_e95f4263601443e890b2e62d4f3b2bdf",
      "statement": "The ledger replays its file on construction but retains only statuses it treats as terminal, namely ok and cancelled, so a failed download is retried on the next run while a cancelled one never is.",
      "evidence": [
        {
          "resource": "repo://pipeline/core/doc_store.py#L44-L72",
