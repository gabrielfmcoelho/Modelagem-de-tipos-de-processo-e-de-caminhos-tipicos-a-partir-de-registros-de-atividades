        }
      ]
    },
    {
      "id": "claim_a8992a6c222a4935be7b602b7facb4b4",
      "statement": "Ledger writes take a lock, create the parent directory, append a single JSON line and update the in-memory terminal map, making the ledger safe to share across the download worker threads.",
