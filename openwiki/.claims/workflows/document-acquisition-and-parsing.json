  "claims": [
    {
      "id": "claim_aaecadab50d747eb8bd6faf128c770b9",
      "statement": "The download stage declares itself conditionally deterministic because its result depends on whether a document is still available in the source system at call time, while the parse stage declares itself outright non-deterministic because its vision and OCR paths vary between identical runs.",
      "evidence": [
        {
          "resource": "repo://pipeline/stages/download.py#L339-L351",
          "version": "repo-lines-v1:sha256:ab126992fc59141c78a323c2122b675f50882873efab462cd0107ca7d1f31988:"
        },
        {
          "resource": "repo://pipeline/stages/parse.py#L364-L375",
          "version": "repo-lines-v1:sha256:807dec96e8341f287999624c1ab712c8c1f106c8e931980e18e9f8e50ad3e6dd:"
        }
      ]
    },
    {
      "id": "claim_e5381ad1a4ee4f76ad8795f000c72dfe",
      "statement": "SEI login terminates the process on invalid credentials, any non-200 response, or a response missing the token field, while connection and timeout errors are retried three times with linearly increasing backoff.",
      "evidence": [
        {
          "resource": "repo://pipeline/core/sei_client.py#L163-L197",
          "version": "repo-lines-v1:sha256:389232803fa66035af4fccb99797502b371b6f8c8ce88bba333aa36cb21455ea:"
        }
      ]
    },
    {
      "id": "claim_43068887d9c9468783b5c87ed634be84",
      "statement": "A SEI document is served on behalf of an administrative unit rather than addressable on its own, so the downloader tries candidate units in order until one succeeds.",
      "evidence": [
        {
          "resource": "repo://pipeline/core/sei_client.py#L122-L160",
          "version": "repo-lines-v1:sha256:aebb2cc2a4f5cde5de11a7e7655cc1eec03c25c5c7b52b99b36f9c05f6980c75:"
        },
        {
          "resource": "repo://pipeline/core/sei_client.py#L50-L59",
          "version": "repo-lines-v1:sha256:0c2e913af0815492629b17ca2eae6e76b7254b7abc67ea4c63f6941ec9c24df5:"
        }
      ]
    },
    {
      "id": "claim_efd92cc1fe964e179fa45771c3ae1a07",
      "statement": "Candidate units are restricted to those belonging to the caller's own agency, matched exactly or by agency prefix, with the document's creating unit appended when it qualifies and is not already present.",
      "evidence": [
        {
          "resource": "repo://pipeline/core/sei_client.py#L91-L107",
          "version": "repo-lines-v1:sha256:6c47b536d3a830a73fd61cbcd269bea5df9bf75926331b12e321652fad98886e:"
        }
      ]
    },
    {
      "id": "claim_71f810dbd5784363a8f175ccc4dd5dd2",
      "statement": "Unit ordering is adaptive within a run: the creating unit sorts first and the remainder sort by descending historical success count, with the success counter incremented on every successful download so units that have worked before are tried earlier for subsequent documents.",
      "evidence": [
        {
          "resource": "repo://pipeline/core/sei_client.py#L109-L119",
          "version": "repo-lines-v1:sha256:789fe066a7f745ec01bcceccc8dd2243394653faf657c6c88c9f7874fa883d26:"
        },
        {
          "resource": "repo://pipeline/core/sei_client.py#L150-L154",
          "version": "repo-lines-v1:sha256:30af8c27d1d03e8ae82384f91a9a687f7e14c704e434693c6c07be98917a56dd:"
        }
      ]
    },
    {
      "id": "claim_496c30f64618428bbe97acc505cde9e3",
      "statement": "A response body reporting that the document was cancelled abandons the remaining units immediately rather than continuing, because a cancellation is a property of the document rather than of the unit being asked.",
      "evidence": [
        {
          "resource": "repo://pipeline/core/sei_client.py#L141-L149",
          "version": "repo-lines-v1:sha256:13a5ff747fc3cdef3b246caba4e73335fef19d71199da1b251f67f7105946729:"
