    },
    {
      "id": "claim_cdea3c6fb59a438b99682f35ad8e3fc7",
      "statement": "The outcome ledger is an append-only NDJSON log recording timestamp, process and document numbers, status, HTTP code, units tried and a detail field for every download attempt.",
