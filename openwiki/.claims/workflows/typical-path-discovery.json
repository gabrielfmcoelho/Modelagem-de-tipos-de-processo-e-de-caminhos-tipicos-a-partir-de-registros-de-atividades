    {
      "id": "claim_de75b0eeba7e4ed4bf65cfc2dbbe9637",
      "statement": "The flow automaton tracks whether the process has started plus two sets of units — those where it is open and those with a pending unacknowledged dispatch — and from that state decides which transitions are legal, always permitting the terminal token.",
      "evidence": [
        {
          "resource": "repo://pipeline/model/constrained.py#L20-L63",
          "version": "repo-lines-v1:sha256:5c979cc35fb032aab2833d2a3c4de0a649dcf52a4cc5f8a13af1901d25761fc1:"
        }
      ]
    },
    {
      "id": "claim_1d9c639630614676845906b2ac5ced34",
      "statement": "Constrained generation filters the model's next-state distribution to states the flow automaton permits, truncates to the top candidates and samples, stopping rather than emitting an impossible step when nothing legal survives.",
      "evidence": [
        {
          "resource": "repo://pipeline/model/constrained.py#L65-L85",
          "version": "repo-lines-v1:sha256:2de6ce963eed29617ca37352e9550aba652bb4c1ff3894fef5fc2c97458854fd:"
        }
      ]
    },
    {
      "id": "claim_f248d385aaab40dab6c24386ad7d87ec",
      "statement": "Because constrained generation consumes only the next-distribution method, the flow constraint is a property of the decoder rather than of any model and applies uniformly across all six.",
