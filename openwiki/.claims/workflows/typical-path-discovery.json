  "claims": [
    {
      "id": "claim_e1e193752eff425a9ba3a7169939d510",
      "statement": "Trace states combine an action type and a unit lane, and three alphabets project them differently, with a declared axis map recording that the unit alphabet retains both action and unit, the itinerary alphabet only the unit, and the procedure alphabet only the action.",
      "evidence": [
        {
          "resource": "repo://pipeline/model/typical_eval.py#L23-L29",
          "version": "repo-lines-v1:sha256:633a62eddd8207d0a30efbc01634352795ca4f38c479cede5da0c2749e55923c:"
        }
      ]
    },
    {
      "id": "claim_b6e784d77d114c70bfdd75d5da197cf6",
      "statement": "A single predicate is the only place alphabet composition is queried, so downstream code never re-derives which alphabet carries a lane.",
      "evidence": [
        {
          "resource": "repo://pipeline/model/typical_eval.py#L28-L29",
          "version": "repo-lines-v1:sha256:4e197399a35cc9fac8af8b86d7656a6920a308fbffedc8255b2bf71b1e3fd3c4:"
        }
      ]
    },
    {
      "id": "claim_485ad5bb001944289f189e77303eea34",
      "statement": "Families with fewer than a minimum number of traces are dropped rather than modelled, applying a minimum-support rule before any model is fitted.",
